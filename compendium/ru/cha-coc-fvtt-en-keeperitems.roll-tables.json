		"Backstory Treasured Possessions": {
			"name": "Предыстория: дорогие сердцу вещи",
			"description": "<p>Бросьте 1D10 или выберите один из следующих вариантов. Возьмите результат и сделайте его конкретным и личным для вашего сыщика.</p>",
			"results": {
				"1-1": {
					"description": "Предмет, связанный с вашим наивысшим навыком (например, дорогой костюм, поддельное удостоверение, кастет)."
				},
				"2-2": {
					"description": "Необходимый предмет для вашей профессии (например, врачебная сумка, автомобиль, отмычки)."
				},
				"3-3": {
					"description": "Памятная вещь из детства (например, комиксы, карманный нож, счастливая монета)."
				},
				"4-4": {
					"description": "Памятная вещь об ушедшем человеке (например, украшение, фотография в бумажнике, письмо)."
				},
				"5-5": {
					"description": "Что-то, подаренное вам вашим значимым человеком (например, кольцо, дневник, карта)."
				},
				"6-6": {
					"description": "Ваша коллекция. Что это? (например, автобусные билеты, чучела животных, пластинки)."
				},
				"7-7": {
					"description": "Что-то, что вы нашли, но не знаете, что это — вы ищете ответы (например, письмо, найденное в шкафу, написанное на неизвестном языке; странная трубка неизвестного происхождения, найденная среди вещей вашего покойного отца; странный серебряный шар, выкопанный вами в саду)."
				},
				"8-8": {
					"description": "Спортивный предмет (например, бита для крикета, бейсбольный мяч с автографом, удочка)."
				},
				"9-9": {
					"description": "Оружие (например, служебный револьвер, ваша старая охотничья винтовка, спрятанный в сапоге нож)."
				},
				"10-10": {
					"description": "Питомец (например, собака, кошка, черепаха)."
				}
			}
		},
		"Backstory Traits": {
			"name": "Предыстория: черты характера",
			"description": "<p>Бросьте 1D10 или выберите один из следующих вариантов. Возьмите результат и сделайте его конкретным и личным для вашего сыщика.</p>",
			"results": {
				"1-1": {
					"description": "Щедрый (например, щедрые чаевые, всегда помогает нуждающемуся, филантроп)."
				},
				"2-2": {
					"description": "Ладит с животными (например, любит кошек, вырос на ферме, хорошо управляется с лошадьми)."
				},
				"3-3": {
					"description": "Мечтатель (например, склонен к фантазиям, провидец, очень творческий)."
				},
				"4-4": {
					"description": "Гедонист (например, душа компании, забавный пьяница, «живи быстро и умри молодым»)."
				},
				"5-5": {
					"description": "Игрок и любитель риска (например, с непроницаемым лицом, готов попробовать всё хоть раз, живёт на грани)."
				},
				"6-6": {
					"description": "Хороший повар (например, печёт чудесные пироги, может приготовить еду почти из ничего, изысканный вкус)."
				},
				"7-7": {
					"description": "Дамский угодник/соблазнительница (например, обходительный, чарующий голос, пленительные глаза)."
				},
				"8-8": {
					"description": "Верный (например, стоит за своих друзей, никогда не нарушает обещание, готов умереть за свои убеждения)."
				},
				"9-9": {
					"description": "Хорошая репутация (например, лучший тамада в стране, самый набожный из мужей, бесстрашный перед лицом опасности)."
				},
				"10-10": {
					"description": "Амбициозный (например, достичь цели, стать начальником, иметь всё)."
				}
			}
		},
