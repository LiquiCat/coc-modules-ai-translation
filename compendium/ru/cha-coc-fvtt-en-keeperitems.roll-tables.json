		"Backstory Meaningful Locations": {
			"name": "Предыстория: значимые места",
			"description": "<p>Бросьте 1D10 или выберите один из следующих вариантов. Возьмите результат и сделайте его конкретным и личным для вашего сыщика. Придумайте название для этих мест.</p>",
			"results": {
				"1-1": {
					"description": "Место вашей учёбы (например, школа, университет, обучение ремеслу)."
				},
				"2-2": {
					"description": "Ваш родной город (например, сельская деревня, торговый городок, оживлённый город)."
				},
				"3-3": {
					"description": "Место, где вы встретили свою первую любовь (например, музыкальный концерт, в отпуске, бомбоубежище)."
				},
				"4-4": {
					"description": "Место для тихих размышлений (например, библиотека, прогулки по вашему поместью, рыбалка)."
				},
				"5-5": {
					"description": "Место для общения (например, джентльменский клуб, местный бар, дом дяди)."
				},
				"6-6": {
					"description": "Место, связанное с вашей идеологией/убеждениями (например, приходская церковь, Мекка, Стоунхендж)."
				},
				"7-7": {
					"description": "Могила значимого человека. Кого? (например, родителя, ребёнка, возлюбленного)."
				},
				"8-8": {
					"description": "Ваш семейный дом (например, загородное поместье, съёмная квартира, приют, в котором вы выросли)."
				},
				"9-9": {
					"description": "Место, где вы были счастливее всего в жизни (например, парковая скамейка, где вы впервые поцеловались, ваш университет, дом вашей бабушки)."
				},
				"10-10": {
					"description": "Ваше место работы (например, офис, библиотека, банк)."
				}
			}
		},
		"Table IX: Sample Phobias": {
			"name": "Таблица IX: примеры фобий",
			"description": "<p>Фобия — это стойкий иррациональный страх чего-либо. Хранитель может выбрать случайным образом (бросьте 1D100) или выбрать подходящую.</p>",
			"results": {
				"1-1": {
					"name": "Аблутофобия"
				},
				"2-2": {
					"name": "Акрофобия"
				},
				"3-3": {
					"name": "Аэрофобия"
				},
				"4-4": {
					"name": "Агорафобия"
				},
